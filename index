            "계단": "https://drive.google.com/thumbnail?id=1Hy9dEq5pUxkG97no8aIwTfiG_R9Rtxj5&sz=w1000",
            "화장실": "https://drive.google.com/thumbnail?id=1PRqGyIxblMB73XSJHf3OCHss9N707P3W&sz=w1000",
            "복도": "https://drive.google.com/thumbnail?id=1t-mvqe1NR9vPGjFwT8UJ6TfxnEFQs5VX&sz=w1000",
            "등굣길": "https://drive.google.com/thumbnail?id=1kUN9bfV5P98a4Rb2YB5OrLNGEcPyKBg6&sz=w1000"
        };

        const heroProfiles = {
            A: { 
                name: "명탐정 히어로", 
                core: "숨은 문제 찾기", 
                desc: "\"어? 이거 좀 불편한데?\" 친구들이 무심코 지나치는 아주 작은 불편함도 돋보기로 보듯 콕 집어내어 찾아내는 우리 반의 명탐정이에요!",
                hint: "평소에 그냥 지나쳤던 문제야! '왜 이런 일이 자꾸 생길까?' 원인을 곰곰이 생각하고, 새로운 도구를 상상해봐.",
                imageId: "1nFCXGtF4nG9V4Xq26qfAKCu6kV_M7NZ8"
            },
            B: { 
                name: "꼼꼼 척척 히어로", 
                core: "차근차근 계획하기", 
                desc: "복잡하고 어려운 일도 문제없어요! 순서대로 차근차근 꼼꼼하게 계획을 세워서 멋지게 해결해 내는 똑똑한 발명가예요!",
                hint: "생각을 순서대로 정리해봐! '어떤 준비물이 필요할까?' 1단계, 2단계 순서대로 적어보면 훨씬 쉬워져.",
                imageId: "1r9ovlgWRTsIUqRgJfUDEQuN8NozhhrOo"
            },
            C: { 
                name: "스피드 히어로", 
                core: "빛보다 빠른 실행", 
                desc: "\"고민할 시간에 일단 해보자!\" 번개처럼 빠르게 움직여서 내 생각을 진짜로 만들어내는 멋진 행동대장이에요!",
                hint: "고민은 그만! 지금 당장 학교에서 쉽게 만들거나 바꿀 수 있는 아이디어를 빠르게 적어보자!",
                imageId: "1ZgWHMLR0RKDGHhbfeZB8Qy1vcT44GXQJ"
            },
            D: { 
                name: "토닥토닥 히어로", 
                core: "마음 알아주기", 
                desc: "친구들의 마음을 따뜻하게 알아주고 다투지 않게 잘 도와주는 우리 반의 든든한 평화 지킴이에요!",
                hint: "친구들의 마음을 떠올려봐! '누가 이 아이디어를 쓰면 가장 기뻐할까?' 친구들을 활짝 웃게 해줄 다정한 해결책을 적어봐.",
                imageId: "1Xr50RgKXTK4Mk-wRxL7wMF5YkKe0Gj7V"
            }
        };

        const elements = {
            steps: Array.from({length: totalSteps}, (_, i) => document.getElementById(`step-${i+1}`)),
            btnPrev: document.getElementById('btn-prev'),
            btnNext: document.getElementById('btn-next'),
            btnSubmit: document.getElementById('btn-submit'),
            btnRestart: document.getElementById('btn-restart'),
            toastEl: document.getElementById('toast'),
            scrollArea: document.querySelector('.overflow-y-auto')
        };

        function showToast(message, duration = 3000) {
            elements.toastEl.textContent = message;
            elements.toastEl.className = "show";
            setTimeout(() => elements.toastEl.classList.remove("show"), duration);
        }

        document.querySelectorAll('.test-option').forEach(btn => {
            btn.addEventListener('click', (e) => {
                const target = e.currentTarget;
                target.parentElement.querySelectorAll('.test-option').forEach(s => s.classList.remove('selected'));
                target.classList.add('selected');
                state.testAnswers[target.dataset.q] = target.dataset.val;
            });
        });

        document.querySelectorAll('input[name="location"]').forEach(radio => {
            radio.addEventListener('change', (e) => {
                state.location = e.target.value;
                document.getElementById('display-location').textContent = state.location;
            });
        });

        document.getElementById('btn-pdf').addEventListener('click', () => {
            window.print();
        });

        function calculateHeroType() {
            const counts = Object.values(state.testAnswers).reduce((acc, val) => {
                acc[val] = (acc[val] || 0) + 1;
                return acc;
            }, {});
            
            let maxType = Object.keys(counts).reduce((a, b) => counts[a] > counts[b] ? a : b);
            state.heroType = heroProfiles[maxType] || heroProfiles[state.testAnswers.t1];
            
            document.getElementById('calc-hero-title').textContent = state.heroType.name;
            document.getElementById('calc-hero-core').innerHTML = `<i class="fa-solid fa-star text-yellow-500 mr-1"></i> 핵심 능력: ${state.heroType.core}`;
            document.getElementById('calc-hero-desc').textContent = state.heroType.desc;
            
            const calcImg = document.getElementById('calc-hero-img');
            if(state.heroType.imageId) {
                calcImg.src = `https://drive.google.com/thumbnail?id=${state.heroType.imageId}&sz=w1000`;
                calcImg.classList.remove('hidden');
            } else {
                calcImg.classList.add('hidden');
            }
        }

        function updateUI() {
            elements.steps.forEach((step, idx) => step.classList.toggle('active', idx + 1 === currentStep));

            const isHiddenStep = [1, 2, 6, 9, 10].includes(currentStep);
            
            const progressContainer = document.getElementById('progress-container');
            const progressBar = document.getElementById('progress-bar');

            if (progressContainer) progressContainer.classList.toggle('hidden', isHiddenStep);
            
            if (!isHiddenStep && progressBar) {
                const progress = (currentStep / totalSteps) * 100;
                progressBar.style.width = `${progress}%`;
            }

            if (currentStep === 8 && state.heroType) {
                document.getElementById('hint-hero-title').textContent = `${state.heroType.name} 힌트 💡`;
                document.getElementById('hint-hero-desc').textContent = state.heroType.hint;
            }

            elements.btnPrev.classList.toggle('invisible', currentStep === 1);
            elements.btnPrev.classList.toggle('hidden', currentStep >= 9);
            
            elements.btnNext.classList.toggle('hidden', currentStep >= 8);
            elements.btnSubmit.classList.toggle('hidden', currentStep !== 8);
            elements.btnRestart.classList.toggle('hidden', currentStep !== 10);

            const nextBtnHTML = {
                1: `시작하기 <i class="fa-solid fa-chevron-right ml-2"></i>`,
                2: `테스트 시작 <i class="fa-solid fa-chevron-right ml-2"></i>`
            };
            elements.btnNext.innerHTML = nextBtnHTML[currentStep] || `다음 단계 <i class="fa-solid fa-chevron-right ml-2"></i>`;
            
            elements.scrollArea.scrollTop = 0;
        }

        elements.btnNext.addEventListener('click', () => {
            if (currentStep === 1) {
                state.heroName = document.getElementById('hero-name-input').value.trim();
                if (!state.heroName) return showToast("멋진 히어로명을 입력해주세요!");
            }
            if ([3, 4, 5].includes(currentStep) && !state.testAnswers[`t${currentStep - 2}`]) return showToast("가장 나다운 행동을 선택해주세요.");
            if (currentStep === 5) calculateHeroType();
            if (currentStep === 7 && !state.location) return showToast("불편함을 느끼는 장소를 선택해주세요.");

            if (currentStep < totalSteps) {
                currentStep++;
                updateUI();
            }
        });

        elements.btnPrev.addEventListener('click', () => {
            if (currentStep > 1) {
                currentStep--;
                updateUI();
            }
        });

        elements.btnSubmit.addEventListener('click', () => {
            state.problem = document.getElementById('problem-input').value.trim();
            state.idea = document.getElementById('idea-input').value.trim();
            
            if (!state.problem) return showToast("불편함을 구체적으로 적어주세요.");
            if (!state.idea) return showToast("개선 아이디어를 제안해주세요.");

            elements.btnSubmit.disabled = true;
            
            currentStep = 9; 
            updateUI();
            
            setTimeout(() => {
                generateReport();
            }, 1500);
        });

        document.addEventListener('keydown', (e) => {
            if (e.key === 'Enter') {
                if (e.isComposing || e.keyCode === 229) return; 
                if (e.target.tagName.toLowerCase() === 'textarea') return;
                
                e.preventDefault();

                if (currentStep === 8 && !elements.btnSubmit.classList.contains('hidden') && !elements.btnSubmit.disabled) {
                    elements.btnSubmit.click();
                } else if (currentStep < 8 && !elements.btnNext.classList.contains('hidden') && !elements.btnNext.disabled) {
                    elements.btnNext.click();
                }
            }
        });

        // 아이디어 내용 성격에 따라 맞춤형 멘토링과 실행 계획을 생성하는 함수
        function getActionPlanData() {
            const hName = state.heroName;
            const ideaText = state.idea;

            const isRuleOrSystem = /규칙|자리|순서|바꾸|제도|시기|공평|토론|조회|시간/.test(ideaText);
            const isInstallOrMake = /설치|만들|기계|도구|상자|카트|문|장치|부착|로봇|자동|화면|모니터|태블릿/.test(ideaText);
            const isCampaignOrShare = /나누|알리|홍보|캠페인|선물|편지|도와|배려/.test(ideaText);

            let adviceHTML = '';
            let planList = [];

            if (isRuleOrSystem) {
                adviceHTML = `<div>💡 멘토의 조언: ${hName} 히어로님! 모두가 함께 지낼 수 있는 새로운 방안을 떠올리다니 정말 기발해요! 사소한 불편함을 다 같이 해결하려는 예쁜 마음이 돋보인답니다. 우리 반을 더 즐겁게 만들어 줄 멋진 도전을 항상 응원할게요!</div>`;
                planList = [
                    `📋 1단계: 아이디어를 적용할 규칙이나 순서의 구체적인 내용 정리하기`,
                    `🛠️ 2단계: 학급 친구들과 선생님께 제안할 실행 방안과 일정 계획하기`,
                    `📢 3단계: 학급 회의나 건의를 통해 실제로 규칙을 적용하고 피드백 받기`
                ];
            } else if (isInstallOrMake) {
                adviceHTML = `<div>💡 멘토의 조언: ${hName} 히어로님! 불편한 점을 콕 집어내고 이를 해결할 멋진 도구나 방법을 찾아냈네요. 상상 속 생각을 실제로 척척 그려내는 모습이 정말 멋진 발명가 같아요! 반짝이는 아이디어를 차근차근 펼쳐 나갈 앞으로의 활약이 정말 기대돼요.</div>`;
                planList = [
                    `📋 1단계: 아이디어를 실현하는 데 필요한 준비물과 도구 목록 적어보기`,
                    `🛠️ 2단계: 필요한 구조나 사용 방법을 알기 쉽게 설계도나 그림으로 표현하기`,
                    `📢 3단계: 실제로 설치하거나 활용할 수 있는 위치와 방안 제안하기`
                ];
            } else if (isCampaignOrShare) {
                adviceHTML = `<div>💡 멘토의 조언: ${hName} 히어로님! 주변 친구들이 겪는 어려움을 따뜻하게 공감하고 함께 나누려는 마음이 정말 예뻐요. 친구들을 먼저 생각하는 다정한 마음이 온 세상에 환한 기쁨을 선물해 줄 거예요! 모두를 웃게 만드는 이 멋진 캠페인을 적극 응원할게요.</div>`;
                planList = [
                    `📋 1단계: 주변 친구들이 겪는 어려움과 필요한 도움 내용 조사하기`,
                    `🛠️ 2단계: 친구들과 함께 실천할 수 있는 나눔 및 참여 방법 기획하기`,
                    `📢 3단계: 주변에 아이디어를 적극적으로 알리고 함께 참여 유도하기`
                ];
            } else {
                // 키워드에 해당하지 않는 경우: 3개의 범용적인 문구 중 하나가 랜덤으로 출력되도록 설정
                const randomGeneralAdvices = [
                    `💡 멘토의 조언: ${hName} 히어로님! 일상의 작은 불편함을 그냥 지나치지 않고 이렇게 기발한 해결책을 찾아내다니 정말 대단해요! 친구들의 마음을 쏙 빼닮은 유쾌한 아이디어랍니다. 반짝이는 아이디어를 차근차근 펼쳐 나갈 앞으로의 활약이 정말 기대돼요!`,
                    `💡 멘토의 조언: ${hName} 히어로님! 우리가 매일 겪는 고민 속에서 이런 멋진 해결 방법을 떠올려내다니 대단한 관찰력이에요! 작은 생각에서 시작된 아이디어가 세상을 바꾼답니다. 내가 직접 주변을 바꿔나가는 이 멋진 도전을 진심으로 응원할게요!`,
                    `💡 멘토의 조언: ${hName} 히어로님! 주변을 세심하게 둘러보고 나만의 창의적인 아이디어를 제안해 준 점이 정말 멋져요! 친구들과 함께 이야기 나누며 내 생각을 키워나가면 더 완벽해질 거예요. 언제나 반짝이는 아이디어를 만들어내는 멋진 히어로가 되어주세요!`
                ];
                
                const randomIndex = Math.floor(Math.random() * randomGeneralAdvices.length);
                adviceHTML = `<div>${randomGeneralAdvices[randomIndex]}</div>`;

                planList = [
                    `📋 1단계: 아이디어를 실행하기 위해 가장 먼저 필요한 행동 생각해보기`,
                    `🛠️ 2단계: 구체적인 실천 순서와 방법을 단계별로 차근차근 적어보기`,
                    `📢 3단계: 주변 친구들과 선생님께 내 아이디어를 멋지게 발표하기`
                ];
            }

            return { advice: adviceHTML, plan: planList };
        }

        function generateReport() {
            document.getElementById('report-hero-name').textContent = state.heroName;
            document.getElementById('res-location').textContent = state.location;

            document.getElementById('res-problem').textContent = state.problem;
            document.getElementById('res-idea').textContent = state.idea;

            const imgElement = document.getElementById('res-image');
            const loaderElement = document.getElementById('image-loader');
            loaderElement.style.display = 'block';
            imgElement.classList.add('hidden');
            
            const imageUrl = locationImages[state.location] || locationImages["교실"];
            imgElement.src = imageUrl;
            
            imgElement.onload = () => {
                loaderElement.style.display = 'none';
                imgElement.classList.remove('hidden');
            };
            
            imgElement.onerror = () => {
                loaderElement.style.display = 'none';
                imgElement.src = "https://dummyimage.com/800x600/fee2e2/ef4444.png&text=이미지를+불러올+수+없습니다";
                imgElement.classList.remove('hidden');
            };

            const reportData = getActionPlanData();

            document.getElementById('res-action').innerHTML = reportData.plan.map(step => 
                `<div class="p-2.5 sm:p-3 bg-gray-50 rounded-xl border border-gray-100 text-gray-800 break-keep flex items-start gap-3 shadow-sm">${step}</div>`
            ).join('');
            
            document.getElementById('res-advice').innerHTML = reportData.advice;

            elements.btnSubmit.disabled = false;
            currentStep = 10;
            updateUI();
        }

        elements.btnRestart.addEventListener('click', () => {
            currentStep = 1;
            ['hero-name-input', 'problem-input', 'idea-input'].forEach(id => document.getElementById(id).value = '');
            document.querySelectorAll('.test-option.selected').forEach(btn => btn.classList.remove('selected'));
            document.querySelectorAll('input[name="location"]').forEach(r => r.checked = false);
            
            const img = document.getElementById('res-image');
            img.src = ''; img.classList.add('hidden');
            document.getElementById('image-loader').style.display = 'block';

            Object.assign(state, { heroName: '', testAnswers: { t1: '', t2: '', t3: '' }, heroType: null, location: '', problem: '', idea: '' });
            updateUI();
        });

        updateUI();
    </script>
</body>
</html>
